# --- Firebase (Auth, Firestore, Storage, AI Logic) ---
# From Firebase console > Project settings > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key for Firebase App Check (strongly recommended in prod)
VITE_RECAPTCHA_SITE_KEY=
# Optional: route Gemini through Firebase AI Logic billed to YOUR project instead of
# asking each user for their own key. Leave unset for public / bring-your-own-key builds.
VITE_HOSTED_AI=

# --- Local development only ---
# A Gemini API key baked into the dev build. Never set this in Netlify:
# Vite inlines VITE_* vars into the public bundle. In production the app talks
# to Gemini through Firebase AI Logic, and users can paste their own key in Settings.
VITE_GEMINI_API_KEY=

# Optional public donation receiving addresses (never private keys / seed phrases).
# BTC and XMR default to the project's addresses; set them to use your own.
# The landing page hides other entries that are empty.
VITE_DONATION_BTC_ADDRESS=
VITE_DONATION_XMR_ADDRESS=
VITE_DONATION_ETH_ADDRESS=
VITE_DONATION_SOL_ADDRESS=
