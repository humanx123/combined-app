{
  "name": "vibe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The agent-native DAW. Cursor for music, powered by Gemini.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-landing.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "screenshots": "node scripts/capture-landing-screenshots.mjs",
    "brand": "node scripts/build-brand.mjs",
    "test:rules": "npx --yes firebase-tools@14.26.0 emulators:exec --only firestore --project demo-vibe-tests \"node --test tests/rules/library.test.mjs\"",
    "promo": "node scripts/frame-promo-images.mjs",
    "appstore-screenshots": "node scripts/screenshots/generate.cjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@google/genai": "^2.30.0",
    "firebase": "^13.0.0",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "jose": "^6.2.13",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tone": "^15.1.22",
    "uqr": "^0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
