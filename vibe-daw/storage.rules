rules_version = '2';

// Sample audio: users/{uid}/samples/{sampleId}. Owner-only, audio only, 40 MB max.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/samples/{sampleId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/account_deletions/$(uid))
        && request.resource.size < 40 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
