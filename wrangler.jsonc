{
  // Gesto Studio on Cloudflare (static assets only: no Worker code, so requests stay free).
  // Build first with scripts/build.sh; deploy with scripts/deploy.sh.
  "$schema": "https://unpkg.com/wrangler@4.145.0/config-schema.json",
  "name": "gesto-studio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
